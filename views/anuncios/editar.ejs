<%- include('../includes/header') %>
<%- include('../includes/navigator') %>

<div class="anuncios-editar main-centered container card">
<h1>Editar Anuncio</h1>
<% if (error) { %>
  <p class="form-error"><%= error %></p>
<% } %>
<form method="post" action="/anuncios/<%= id %>/editar">
  <div class="form-group">
    <label>Imagen actual</label>
    <img src="<%= anuncio.Imagen ? anuncio.Imagen : '/img/default.jpg' %>" alt="Imagen del producto" class="img-preview" onerror="this.onerror=null;this.src='/img/default.jpg';">
  </div>
  <div class="form-group">
    <label>Reemplazar imagen (enlace)</label>
    <input type="text" name="imagen" placeholder="https://...">
  </div>
  <div class="form-group">
    <label>Titulo</label>
    <input type="text" name="titulo" value="<%= anuncio.Titulo %>" required>
  </div>
  <div class="form-group">
    <label>Descripcion</label>
    <textarea name="descripcion" required><%= anuncio.Descripcion || '' %></textarea>
  </div>
  <div class="form-group">
    <label>Precio</label>
    <input type="number" name="precio" value="<%= anuncio.Precio %>" required>
  </div>
  <div class="form-group">
    <label>Estado</label>
    <select name="estado" required>
      <option value="disponible" <%= anuncio.Estado === 'disponible' ? 'selected' : '' %>>Disponible</option>
      <option value="reservado" <%= anuncio.Estado === 'reservado' ? 'selected' : '' %>>Reservado</option>
      <option value="vendido" <%= anuncio.Estado === 'vendido' ? 'selected' : '' %>>Vendido</option>
    </select>
  </div>
  <div class="form-actions">
    <button type="submit" class="primary-btn">Guardar cambios</button>
    <a href="/anuncios/<%= id %>" class="btn-secondary">Volver al detalle</a>
  </div>
</form>
<%- include('../includes/footer') %>
</div>
