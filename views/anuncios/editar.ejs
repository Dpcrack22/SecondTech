<%- include('../includes/header') %>
<%- include('../includes/navigator') %>

<h1>Editar Anuncio</h1>
<% if (error) { %>
  <p style="color:red"><%= error %></p>
<% } %>
<form method="post" action="/anuncios/<%= id %>/editar">
  <label>Título:<br>
    <input type="text" name="titulo" value="<%= anuncio.Titulo %>" required>
  </label><br>
  <label>Descripción:<br>
    <textarea name="descripcion" required><%= anuncio.Descripcion || '' %></textarea>
  </label><br>
  <label>Precio:<br>
    <input type="number" name="precio" value="<%= anuncio.Precio %>" required>
  </label><br>
  <label>Estado:<br>
    <select name="estado" required>
      <option value="disponible" <%= anuncio.Estado === 'disponible' ? 'selected' : '' %>>Disponible</option>
      <option value="reservado" <%= anuncio.Estado === 'reservado' ? 'selected' : '' %>>Reservado</option>
      <option value="vendido" <%= anuncio.Estado === 'vendido' ? 'selected' : '' %>>Vendido</option>
    </select>
  </label><br>
  <button type="submit">Guardar cambios</button>
</form>
<a href="/anuncios/<%= id %>">Volver al detalle</a>
<%- include('../includes/footer') %>
