
<%- include('../includes/header') %>
<%- include('../includes/navigator') %>

<div class="anuncios-lista main-centered container card">
<h1>Listado de Anuncios</h1>

<form method="get" action="/anuncios" class="filtros-form">
  <label for="categoria">Categoría:</label>
  <select name="categoria" id="categoria">
    <option value="" <%= !categoria ? 'selected' : '' %>>Todas</option>
    <option value="movil" <%= categoria === 'movil' ? 'selected' : '' %>>Móvil</option>
    <option value="consola" <%= categoria === 'consola' ? 'selected' : '' %>>Consola</option>
    <option value="pc" <%= categoria === 'pc' ? 'selected' : '' %>>PC</option>
    <option value="componentes" <%= categoria === 'componentes' ? 'selected' : '' %>>Componentes</option>
    <option value="juguetes" <%= categoria === 'juguetes' ? 'selected' : '' %>>Juguetes</option>
    <option value="libros" <%= categoria === 'libros' ? 'selected' : '' %>>Libros</option>
    <option value="ropa" <%= categoria === 'ropa' ? 'selected' : '' %>>Ropa</option>
    <option value="hogar" <%= categoria === 'hogar' ? 'selected' : '' %>>Hogar</option>
    <option value="deportes" <%= categoria === 'deportes' ? 'selected' : '' %>>Deportes</option>
    <option value="otros" <%= categoria === 'otros' ? 'selected' : '' %>>Otros</option>
  </select>
  <label for="estado">Estado:</label>
  <select name="estado" id="estado">
    <option value="" <%= !estado ? 'selected' : '' %>>Todos</option>
    <option value="disponible" <%= estado === 'disponible' ? 'selected' : '' %>>Disponible</option>
    <option value="reservado" <%= estado === 'reservado' ? 'selected' : '' %>>Reservado</option>
    <option value="vendido" <%= estado === 'vendido' ? 'selected' : '' %>>Vendido</option>
  </select>
  <button type="submit">Filtrar</button>
</form>

<div class="anuncios-grid">
  <% if (anuncios.length === 0) { %>
    <div class="anuncio-empty">No hay anuncios para mostrar.</div>
  <% } %>
  <% anuncios.forEach(function(anuncio) { %>
    <article class="anuncio-card">
      <div class="anuncio-media">
        <img src="<%= anuncio.Imagen ? anuncio.Imagen : '/img/default.jpg' %>"
             alt="Imagen del producto"
             onerror="this.onerror=null;this.src='/img/default.jpg';">
      </div>
      <div class="anuncio-body">
        <div class="anuncio-info">
          <h2 class="anuncio-title"><%= anuncio.Titulo %></h2>
          <p class="anuncio-price"><%= anuncio.Precio %> €</p>
        </div>
        <div class="anuncio-tags">
          <span class="tag tag-category"><%= anuncio.Categoria %></span>
          <span class="tag tag-status"><%= anuncio.Estado %></span>
        </div>
      </div>
      <div class="anuncio-actions">
        <a href="/anuncios/<%= anuncio.id %>" class="btn">Ver detalle</a>
      </div>
    </article>
  <% }) %>
</div>
