<%- include('../includes/header') %>
<%- include('../includes/navigator') %>


<div class="anuncios-detalle main-centered container">
<img src="/IMG/<%= anuncio.Imagen ? anuncio.Imagen : 'default.jpg' %>" alt="Imagen del producto" style="max-width:300px;display:block;margin:0 auto 2rem auto;">
<h1>Detalle del Anuncio</h1>


<ul>
  <li><strong>Título:</strong> <%= anuncio.Titulo || anuncio.titulo %></li>
  <li><strong>Descripción:</strong> <%= anuncio.Descripcion || anuncio.descripcion %></li>
  <li><strong>Categoría:</strong> <%= anuncio.Categoria || anuncio.categoria %></li>
  <li><strong>Precio:</strong> <%= anuncio.Precio || anuncio.precio %> €</li>
  <li><strong>Contacto:</strong> <%= anuncio.Contacto || anuncio.contacto %></li>
  <li><strong>Fecha de publicación:</strong> <%= anuncio.Fecha || anuncio.fecha || (anuncio.createdAt ? new Date(anuncio.createdAt).toLocaleDateString('es-ES') : 'No disponible') %></li>
  <li>
    <strong>Estado:</strong> <%= anuncio.Estado || anuncio.estado %>
    <form method="post" action="/anuncios/<%= id %>/cambiar-estado" style="display:inline; margin-left:10px;">
      <select name="estado" onchange="this.form.submit()">
        <option value="disponible" <%= (anuncio.Estado === 'disponible' || anuncio.estado === 'disponible') ? 'selected' : '' %>>Disponible</option>
        <option value="reservado" <%= (anuncio.Estado === 'reservado' || anuncio.estado === 'reservado') ? 'selected' : '' %>>Reservado</option>
        <option value="vendido" <%= (anuncio.Estado === 'vendido' || anuncio.estado === 'vendido') ? 'selected' : '' %>>Vendido</option>
      </select>
    </form>
  </li>
</ul>

<a href="/anuncios/<%= id %>/editar">Editar anuncio</a>


<%- include('../includes/footer') %>
</div>
